          <mxGeometry x="360" y="375" width="450" height="75" as="geometry" />
        </mxCell>

        <mxCell id="io_poseobs" value="&lt;b&gt;&amp;lt;&amp;lt;record&amp;gt;&amp;gt; PoseObservation&lt;/b&gt;&lt;hr/&gt;double timestamp&lt;br/&gt;Pose3d pose&lt;br/&gt;double ambiguity  &lt;i&gt;(MT1 only)&lt;/i&gt;&lt;br/&gt;int tagCount&lt;br/&gt;double averageTagDistance&lt;br/&gt;PoseObservationType type&lt;br/&gt;&amp;nbsp;&amp;nbsp;MEGATAG_1 | MEGATAG_2&lt;br/&gt;double linearStdDev&lt;br/&gt;double angularStdDev"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffacd;strokeColor=#999999;fontSize=10;align=left;spacingLeft=8;"
