          vertex="1" parent="1">
          <mxGeometry x="510" y="718" width="130" height="90" as="geometry" />
        </mxCell>

        <mxCell id="v_mt1enable" value="&lt;b&gt;enableMT1&lt;/b&gt;&lt;br/&gt;normally OFF (gyro provides rotation)&lt;br/&gt;auto-enables if gyro disconnects"
          style="shape=callout;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;"
          vertex="1" parent="1">
          <mxGeometry x="498" y="860" width="190" height="70" as="geometry" />
        </mxCell>

        <mxCell id="v_mt1filters" value="&lt;b&gt;MT1 Reject Conditions (ANY = REJECT):&lt;/b&gt;&lt;br/&gt;&#x2022; tagCount &lt; 2  (MT1MinTags)&lt;br/&gt;&#x2022; linear velocity &gt; 0.25 m/s&lt;br/&gt;&#x2022; angular velocity &gt; 1&#xb0;/s (0.01745 rad/s)&lt;br/&gt;&#x2022; |Z| &gt; 0.25 m&lt;br/&gt;&#x2022; X &lt; 0 or X &gt; field length (~16.5m)&lt;br/&gt;&#x2022; Y &lt; 0 or Y &gt; field width (~8.2m)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="720" y="635" width="290" height="195" as="geometry" />
        </mxCell>

        <mxCell id="v_mt2filters" value="&lt;b&gt;MT2 Reject Conditions (ANY = REJECT):&lt;/b&gt;&lt;br/&gt;&#x2022; |Z| &gt; 0.25 m&lt;br/&gt;&#x2022; X &lt; 0 or X &gt; field length (~16.5m)&lt;br/&gt;&#x2022; Y &lt; 0 or Y &gt; field width (~8.2m)&lt;br/&gt;&lt;br/&gt;&lt;i&gt;No velocity check — gyro provides stable rotation&lt;/i&gt;"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="720" y="875" width="290" height="155" as="geometry" />
        </mxCell>

        <mxCell id="v_mt1accept" value="MT1 ACCEPTED"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="1090" y="640" width="160" height="50" as="geometry" />
