        <!-- === LANE 4: OUTPUTS === -->

        <mxCell id="o_logger" value="&lt;b&gt;AdvantageKit Logger (per camera)&lt;/b&gt;&lt;hr/&gt;Vision/{cam}/TagPoses&lt;br/&gt;Vision/{cam}/MegaTag1/RobotPose  (ALL)&lt;br/&gt;Vision/{cam}/MegaTag1/RobotPoseAccepted&lt;br/&gt;Vision/{cam}/MegaTag1/RobotPoseRejected&lt;br/&gt;Vision/{cam}/MegaTag2/RobotPose  (ALL)&lt;br/&gt;Vision/{cam}/MegaTag2/RobotPoseAccepted&lt;br/&gt;Vision/{cam}/MegaTag2/RobotPoseRejected&lt;br/&gt;Vision/Summary/... (all cameras combined)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=9;align=left;spacingLeft=6;"
