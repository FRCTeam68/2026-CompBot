        <mxCell id="o_leds" value="&lt;b&gt;LED Indicators&lt;/b&gt;&lt;hr/&gt;RED: camera disconnected&lt;br/&gt;BLUE: connected + observations seen&lt;br/&gt;GREEN: connected, no observations this cycle"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;"
          vertex="1" parent="1">
          <mxGeometry x="1100" y="1320" width="310" height="150" as="geometry" />
