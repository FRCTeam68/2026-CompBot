          <mxGeometry x="870" y="215" width="240" height="275" as="geometry" />
        </mxCell>

        <mxCell id="io_viinputs" value="&lt;b&gt;VisionIOInputs&lt;/b&gt; (@AutoLog)&lt;hr/&gt;boolean connected&lt;br/&gt;int pipelineIndex&lt;br/&gt;double cpuTempCelsius&lt;br/&gt;double cpuUsage&lt;br/&gt;double ramUsage&lt;br/&gt;double fps&lt;br/&gt;&lt;b&gt;PoseObservation[] poseObservations&lt;/b&gt;&lt;br/&gt;int[] tagIds"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=10;align=left;spacingLeft=8;"
          vertex="1" parent="1">
          <mxGeometry x="1180" y="215" width="250" height="255" as="geometry" />
        </mxCell>


        <!-- === LANE 3: VISION.PERIODIC() === -->

        <mxCell id="v_loginputs" value="Logger.processInputs()&lt;br/&gt;Logs all VisionIOInputs fields&lt;br/&gt;(connected, fps, tagIds, poseObservations...)"
