        </mxCell>

        <mxCell id="o_consumer" value="&lt;b&gt;VisionConsumer.accept()&lt;/b&gt;&lt;hr/&gt;Pose2d visionRobotPoseMeters&lt;br/&gt;double timestampSeconds&lt;br/&gt;Matrix&lt;N3,N1&gt; stdDevs&lt;br/&gt;&amp;nbsp;= VecBuilder.fill(linStdDev, linStdDev, angStdDev)&lt;br/&gt;&lt;br/&gt;&lt;i&gt;accepted observations only&lt;/i&gt;&lt;br/&gt;&#x2192; SwerveDrivePoseEstimator"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=6;"
          vertex="1" parent="1">
