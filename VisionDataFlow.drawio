        <mxCell id="h_ll3g" value="&lt;b&gt;Limelight LL_3G&lt;/b&gt;&lt;br/&gt;limelight-threeg&lt;br/&gt;10.0.68.9&lt;br/&gt;MTStdDevFactor = 0.5"
