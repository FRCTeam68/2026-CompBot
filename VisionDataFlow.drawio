        <mxCell id="io_stddev" value="&lt;b&gt;StdDev Calculation&lt;/b&gt;&lt;br/&gt;MT1: linearStdDev=&#x221e;,  angularStdDev = baseline(0.06) &#xd7; dist&#xb2; / tagCount &#xd7; 1.0 &#xd7; camFactor&lt;br/&gt;MT2: linearStdDev = baseline(0.02) &#xd7; dist&#xb2; / tagCount &#xd7; 0.5 &#xd7; camFactor,  angularStdDev=&#x221e;"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;"
