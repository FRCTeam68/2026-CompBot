          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lane 3 → Lane 4 Consumer (accepted only) -->
        <mxCell id="e26" value="Pose2d + stdDevs" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;strokeColor=#82b366;" edge="1" source="v_mt1accept" target="o_consumer" parent="1">
