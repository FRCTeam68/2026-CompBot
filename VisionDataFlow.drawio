        <mxCell id="h_nt" value="&lt;b&gt;NetworkTables Topics (per camera)&lt;/b&gt;&lt;br/&gt;&#x2192;  botpose_wpiblue  (MT1: x,y,z,rx,ry,rz,latency,tagCt,ambiguity,avgDist,avgArea)&lt;br/&gt;&#x2192;  botpose_orb_wpiblue  (MT2: same format, rotation from gyro)&lt;br/&gt;&#x2190;  robot_orientation  (yaw, yawRate, pitch, pitchRate, roll, rollRate)"
