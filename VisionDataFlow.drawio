        </mxCell>
        <mxCell id="e21" value="any fails" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;strokeColor=#b85450;" edge="1" source="v_mt2filters" target="v_mt2reject" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lane 3 → Lane 4 Logger (all outcomes) -->
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#3f51b5;" edge="1" source="v_mt1accept" target="o_logger" parent="1">
