        </mxCell>
        <mxCell id="e10" value="stored in array" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="io_poseobs" target="io_viinputs" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lane 2 → Lane 3 -->
        <mxCell id="e11" value="updateInputs() completes" style="edgeStyle=orthogonalEdgeStyle;fontSize=9;" edge="1" source="io_viinputs" target="v_loginputs" parent="1">
